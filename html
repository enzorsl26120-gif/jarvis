<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JCOPLAY</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      font-family: Arial, sans-serif;
      background: #080808;
      color: white;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .app {
      width: 92%;
      max-width: 600px;
      text-align: center;
      padding: 30px 20px;
      border-radius: 25px;
      background: #111;
      border: 1px solid #292929;
      box-shadow: 0 0 40px rgba(255,255,255,.08);
    }

    h1 {
      font-size: 42px;
      margin-bottom: 10px;
    }

    .subtitle {
      color: #aaa;
      margin-bottom: 30px;
    }

    button {
      width: 100%;
      padding: 16px;
      margin: 8px 0;
      border: 0;
      border-radius: 14px;
      background: white;
      color: black;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
    }

    button:active {
      transform: scale(.98);
    }

    #status {
      margin-top: 20px;
      color: #aaa;
      min-height: 24px;
    }
  </style>
</head>

<body>

  <main class="app">
    <h1>JCOPLAY</h1>
    <p class="subtitle">Bienvenue sur ton application</p>

    <button onclick="startApp()">Lancer JCOPLAY</button>
    <button onclick="showInfo()">À propos</button>

    <div id="status">Système prêt.</div>
  </main>

  <script>
    function startApp() {
      document.getElementById("status").textContent =
        "JCOPLAY est lancé !";
    }

    function showInfo() {
      document.getElementById("status").textContent =
        "JCOPLAY — application créée avec HTML, CSS et JavaScript.";
    }
  </script>

</body>
</html>